---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaFigure from '../../components/MediaFigure.astro';
import { getCatalogue, seriesUrl } from '../../lib/content';
const { reading } = await getCatalogue();
---
<BaseLayout title="文章 · Wonderloom" description="从冰晕、日月运行与历法，到山峰的巍峨：几条可以跟着走下去的探索路线。">
  <div class="shell">
    <header class="page-intro">
      <p class="topic">文章与系列</p>
      <h1>沿着一个问题，<br />走得远一点。</h1>
      <p>有些问题，一篇讲不完。这里把它们整理成几条阅读路线，<br class="desktop-break" />从最初的好奇，走向推导、计算和新的理解。</p>
    </header>
    <div class="series-index">
      {reading.map((entry) => (
        <article class="series-preview">
          <MediaFigure id={entry.data.media} compact />
          <div>
            <p class="topic">{entry.data.topic} · {entry.data.chapters.length} 篇已发表</p>
            <h2><a href={seriesUrl(entry)}>{entry.data.title}</a></h2>
            <p>{entry.data.summary}</p>
            <p class="muted">{entry.data.readingNote}</p>
            <a class="text-link" href={seriesUrl(entry)}>查看导读与目录</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
