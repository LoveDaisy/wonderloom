---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResearchFigure from '../../components/research/ResearchFigure.astro';
import NotebookIntro from '../../components/NotebookIntro.astro';
import NotebookSection from '../../components/NotebookSection.astro';
import WorkContext from '../../components/WorkContext.astro';
import NotebookRelations from '../../components/NotebookRelations.astro';
import { getCatalogue, relatedRelations, requireEntry, seriesChapters } from '../../lib/content';
export async function getStaticPaths() {
  const { series } = await getCatalogue();
  return series.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
interface Props { entry: CollectionEntry<'series'>; }
const { entry } = Astro.props;
const { Content } = await render(entry);
const catalogue = await getCatalogue();
const work = requireEntry(catalogue.worksById, `series:${entry.id}`, entry.id);
const localRelations = relatedRelations(work.id);
const chapters = seriesChapters(entry, catalogue.authorArticles, catalogue.articles);
const chapterWorkIds = new Set(chapters.filter((chapter) => chapter.internal).map((chapter) => `article:${chapter.href.split('/').filter(Boolean).at(-1)}`));
const continuations = localRelations.filter((relation) => !chapterWorkIds.has(relation.from) && !chapterWorkIds.has(relation.to));
---
<BaseLayout title={`${entry.data.title} · Wonderloom`} description={entry.data.summary}>
  <NotebookIntro label={entry.data.topic} title={entry.data.title} description={entry.data.question} parent={{href: '/writing/', title: '文章与系列'}}>
    <a class="research-link" href="#chapters">查看章节目录 ↓</a>
  </NotebookIntro>
  <NotebookSection label="这一组问题" id="series-overview">
    <WorkContext workId={work.id} slot="note" />
    <div class="nb-prose"><Content /></div>
    <ResearchFigure id={entry.data.media} eager />
    {entry.id === 'ice-halos' && <ResearchFigure id="pyramids" />}
  </NotebookSection>
  <NotebookSection label="从这里开始读" id="chapters">
    <div class="series-reading-note nb-surface"><h3>阅读说明</h3><p>{entry.data.readingNote}</p></div>
    <div class="series-chapters"><header><h3>章节目录</h3><p class="nb-meta">{chapters.length} 篇</p></header><ol class="chapter-list">
          {chapters.map((source) => {
            return (
            <li>
              <a href={source.href}>
                <span class="chapter-label">{source.chapterLabel}</span>
                <span class="nb-entry-title">{source.title}</span>
                <span class="external-mark">{source.internal ? '阅读全文 →' : '知乎 ↗'}</span>
              </a>
            </li>
            );
          })}
        </ol></div>
  </NotebookSection>
  <NotebookRelations relations={continuations} currentId={work.id} title="把理解放进程序" />
</BaseLayout>
