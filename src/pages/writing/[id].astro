---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResearchFigure from '../../components/research/ResearchFigure.astro';
import NotebookRelations from '../../components/NotebookRelations.astro';
import { getCatalogue, relatedRelations, requireEntry, seriesChapters } from '../../lib/content';

export async function getStaticPaths() {
  const { series } = await getCatalogue();
  return series.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
interface Props { entry: CollectionEntry<'series'>; }
const { entry } = Astro.props;
const { Content } = await render(entry);
const catalogue = await getCatalogue();
const work = requireEntry(catalogue.worksById, `series:${entry.id}`, entry.id);
const chapters = seriesChapters(entry, catalogue.authorArticles, catalogue.articles);
const chapterWorkIds = new Set(chapters.filter((chapter) => chapter.internal).map((chapter) => `article:${chapter.href.split('/').filter(Boolean).at(-1)}`));
const continuations = relatedRelations(work.id).filter((relation) => !chapterWorkIds.has(relation.from) && !chapterWorkIds.has(relation.to));
---
<BaseLayout title={`${entry.data.title} · Wonderloom`} description={entry.data.summary} theme="cyanotype">
  <div class="loom-content site-shell series-page">
    <header class="loom-opening">
      <div><nav class="loom-parent" aria-label="面包屑"><a href="/writing/">文章与系列</a><span aria-hidden="true"> / </span>{entry.data.title}</nav><h1>{entry.data.question}</h1></div>
      <div class="loom-opening-aside"><p class="loom-series-name">{entry.data.title}</p><p>{entry.data.summary}</p><a href="#chapters">查看章节目录</a></div>
    </header>
    <section class="loom-split loom-series-overview" id="series-overview" aria-labelledby="series-overview-title">
      <div class="loom-section-heading"><h2 id="series-overview-title">这一组问题</h2></div>
      <div class="loom-prose"><Content />{entry.data.media !== 'halo' && <ResearchFigure id={entry.data.media} />}{entry.id === 'ice-halos' && <ResearchFigure id="pyramids" />}</div>
    </section>
    <section class="loom-split loom-series-chapters" id="chapters" aria-labelledby="chapters-title">
      <div class="loom-section-heading"><h2 id="chapters-title">顺着问题往下读</h2><p>{entry.data.readingNote}</p></div>
      <div><p class="loom-chapter-count">{chapters.length} 篇文章</p><ol class="loom-thread-list">{chapters.map((chapter) => <li><a href={chapter.href}><span class="loom-thread-node" aria-hidden="true"></span><span class="loom-thread-number">{chapter.chapterLabel}</span><span class="loom-thread-title">{chapter.title}</span><span class="loom-thread-action">{chapter.internal ? '读本站全文' : '去知乎阅读'}</span></a></li>)}</ol></div>
    </section>
    <NotebookRelations relations={continuations} currentId={work.id} title="把理解放进程序" />
  </div>
</BaseLayout>
