---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WorkContext from '../../../components/WorkContext.astro';
import NotebookIntro from '../../../components/NotebookIntro.astro';
import NotebookSection from '../../../components/NotebookSection.astro';
import NotebookRelations from '../../../components/NotebookRelations.astro';
import { getCatalogue, relatedRelations, requireEntry, sourceTitle, sourceUrl } from '../../../lib/content';
export async function getStaticPaths() { const { articles } = await getCatalogue(); return articles.map((entry) => ({ params: { id: entry.id }, props: { entry } })); }
interface Props { entry: CollectionEntry<'articles'>; }
const { entry } = Astro.props;
const { Content } = await render(entry);
const catalogue = await getCatalogue();
const work = requireEntry(catalogue.worksById, `article:${entry.id}`, entry.id);
const localRelations = relatedRelations(work.id);
const title = sourceTitle(entry.data.sourceId, entry.id);
---
<BaseLayout title={`${title} · Wonderloom`} description={entry.data.summary}>
  <NotebookIntro label="文章导读" title={title} description={entry.data.summary} parent={{href: '/writing/', title: '文章与系列'}} />
  <NotebookSection label="读前几句话" id="article-guide">
    <WorkContext workId={work.id} slot="note" />
    <div class="nb-prose"><Content /></div>
  </NotebookSection>
  <NotebookSection label="阅读原文" id="article-source" surface>
    <p>本站提供编辑导读；完整文章仍发布在知乎。</p>
    <a class="research-link" href={sourceUrl(entry.data.sourceId, entry.id)}>前往知乎阅读全文 <span aria-hidden="true">↗</span></a>
  </NotebookSection>
  <NotebookRelations relations={localRelations} currentId={work.id} title="这篇文章的直接关联" />
</BaseLayout>
