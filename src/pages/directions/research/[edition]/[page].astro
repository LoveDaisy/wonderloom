---
import ResearchLayout from '../../../../layouts/ResearchLayout.astro';
import ResearchHome from '../../../../components/research/ResearchHome.astro';
import ResearchWriting from '../../../../components/research/ResearchWriting.astro';
import ResearchExplore from '../../../../components/research/ResearchExplore.astro';
import { editions, editionPages } from '../../../../data/research-editions';
export function getStaticPaths() {
  return editions.flatMap(edition => editionPages.map(page => ({
    params: { edition: edition.id, page: page.id },
    props: { edition, page },
  })));
}
const { edition, page } = Astro.props;
---
<ResearchLayout edition={edition.id} page={page.id} title={`${edition.name} · ${page.title}`}>
  {page.id === 'home' && <ResearchHome edition={edition.id} />}
  {page.id === 'writing' && <ResearchWriting edition={edition.id} legacySample />}
  {page.id === 'explore' && <ResearchExplore edition={edition.id} legacySample />}
</ResearchLayout>
