---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NotebookIntro from '../../../components/NotebookIntro.astro';
import NotebookSection from '../../../components/NotebookSection.astro';
import { readingPaths, type ReadingPath } from '../../../data/content-network';
import { getCatalogue, requireEntry } from '../../../lib/content';
export function getStaticPaths() { return readingPaths.map((path) => ({ params: { id: path.id }, props: { path } })); }
interface Props { path: ReadingPath; }
const { path } = Astro.props;
const { worksById } = await getCatalogue();
const steps = path.steps.map((id) => requireEntry(worksById, id, path.id));
---
<BaseLayout title={`${path.title} · 阅读路径 · Wonderloom`} description={path.description}>
  <NotebookIntro label="阅读路径" title={path.title} description={path.description} parent={{href: '/explore/', title: '探索'}} />
  <NotebookSection label="这条线的起点" id="path-introduction" surface>
    <p>{path.introduction}</p>
  </NotebookSection>
  <NotebookSection label="一步一步读" id="path-steps">
    <p slot="note">{steps.length} 个相连的作品</p>
    <ol class="nb-path-steps">{steps.map(work => <li><article><h3><a href={work.href}>{work.title} ↗</a></h3><p class="nb-meta">{work.kind}</p><p>{work.summary}</p><a class="research-link" href={work.href}>进入{work.kind}<span aria-hidden="true"> →</span></a></article></li>)}</ol>
  </NotebookSection>
</BaseLayout>
