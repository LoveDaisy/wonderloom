---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResearchFigure from '../../components/research/ResearchFigure.astro';
import NotebookIntro from '../../components/NotebookIntro.astro';
import NotebookSection from '../../components/NotebookSection.astro';
import WorkContext from '../../components/WorkContext.astro';
import NotebookRelations from '../../components/NotebookRelations.astro';
import { getCatalogue, relatedRelations, requireEntry, seriesUrl } from '../../lib/content';
export async function getStaticPaths() {
  const { projects } = await getCatalogue();
  return projects.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
interface Props { entry: CollectionEntry<'projects'>; }
const { entry } = Astro.props;
const { Content } = await render(entry);
const { seriesById } = await getCatalogue();
const related = entry.data.relatedSeries.map((ref) => requireEntry(seriesById, ref.id, entry.id));
const catalogue = await getCatalogue();
const work = requireEntry(catalogue.worksById, `project:${entry.id}`, entry.id);
const localRelations = relatedRelations(work.id);
---
<BaseLayout title={`${entry.data.title} · Wonderloom`} description={entry.data.summary}>
  <NotebookIntro label={entry.data.kind} title={entry.data.title} description={entry.data.subtitle} parent={{href: '/projects/', title: '项目'}} />
  <NotebookSection label="问题与实现" id="project-overview">
    <WorkContext workId={work.id} slot="note" />
    <ResearchFigure id={entry.data.media} eager />
    <div class="nb-prose"><Content /></div>
  </NotebookSection>
  <NotebookSection label="试用与了解" id="project-resources" surface>
    <ul class="nb-link-list">{entry.data.links.map(link => <li><a href={link.url}>{link.label} <span aria-hidden="true">↗</span></a></li>)}</ul>
    {related.length > 0 && <div class="nb-note"><span class="quiet-label">背后的探索</span><ul class="nb-link-list">{related.map(series => <li><a href={seriesUrl(series)}>{series.data.title} ↗</a></li>)}</ul></div>}
  </NotebookSection>
  <NotebookRelations relations={localRelations} currentId={work.id} title="这个项目的直接关联" />
</BaseLayout>
