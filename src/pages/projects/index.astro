---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaFigure from '../../components/MediaFigure.astro';
import { getCatalogue, projectUrl } from '../../lib/content';
const { projects } = await getCatalogue();
---
<BaseLayout title="项目 · Wonderloom" description="把好奇变成可以运行的程序。了解 Lumice 冰晕光线追踪模拟器及其背后的问题。">
  <div class="shell">
    <header class="page-intro">
      <p class="topic">动手做出来的东西</p>
      <h1>让想法，<br />运行起来。</h1>
      <p>写文章，是把理解讲清楚。写程序，则是把理解放进一组条件里，<br class="desktop-break" />看它能否真的生成我们期待的结果。</p>
    </header>
    <div class="projects-index">
      {projects.map((entry) => (
        <article class="project-preview">
          <MediaFigure id={entry.data.media} compact />
          <div>
            <h2><a href={projectUrl(entry)}>{entry.data.title}</a></h2>
            <p class="topic">{entry.data.kind}</p><p class="project-subtitle">{entry.data.subtitle}</p>
            <p>{entry.data.summary}</p>
            <a class="text-link" href={projectUrl(entry)}>了解项目与使用方式</a>
          </div>
        </article>
      ))}
    </div>
    <div class="cross-note"><p>也有一些探索，先写成了文章。</p><a class="text-link" href="/writing/">从历法、山峰和冰晕开始读</a></div>
  </div>
</BaseLayout>
