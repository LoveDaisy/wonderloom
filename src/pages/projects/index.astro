---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotebookIntro from '../../components/NotebookIntro.astro';
import NotebookSection from '../../components/NotebookSection.astro';
import ResearchFigure from '../../components/research/ResearchFigure.astro';
import { getCatalogue, projectUrl } from '../../lib/content';
const { projects } = await getCatalogue();
---
<BaseLayout title="项目 · Wonderloom" description="把好奇变成可以运行的程序。了解 Lumice 冰晕光线追踪模拟器及其背后的问题。">
  <NotebookIntro label="动手做出来的东西" title="让想法，运行起来。" description="写文章，是把理解讲清楚。写程序，则是把理解放进一组条件里，看它能否真的生成我们期待的结果。" />
  {projects.map(entry => <NotebookSection label={entry.data.kind} id={`project-${entry.id}`}>
    <div class="nb-project-summary">
      <h2><a href={projectUrl(entry)}>{entry.data.title} ↗</a></h2>
      <p>{entry.data.subtitle}</p><p>{entry.data.summary}</p>
      <a class="research-link" href={projectUrl(entry)}>了解项目与使用方式 ↗</a>
    </div>
    <ResearchFigure id={entry.data.media} />
  </NotebookSection>)}
  <NotebookSection label="背后的探索" id="project-reading" surface>
    <p>也有一些探索，先写成了文章。</p><a class="research-link" href="/writing/">从历法、山峰和冰晕开始读 ↗</a>
  </NotebookSection>
</BaseLayout>
