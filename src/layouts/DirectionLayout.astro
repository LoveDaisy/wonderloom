---
import { directions, type DirectionId } from '../data/directions';
import { site } from '../data/site';
import '../styles/directions.css';
interface Props { direction?: DirectionId; }
const { direction } = Astro.props;
const current = directions.find((item) => item.id === direction);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={site.description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content={current?.palette[0] ?? '#f7f4ea'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{current ? `${current.name} · Wonderloom 首页试样` : '三个方向 · Wonderloom'}</title>
  </head>
  <body class:list={['design', direction ?? 'directory']}>
    <a class="design-skip" href="#main">跳到主要内容</a>
    <slot />
    {current && <nav class="direction-switch" aria-label="切换首页视觉方案">
      <a class="switch-index" href="/directions/">首页试样 <span aria-hidden="true">↗</span></a>
      <div>{directions.map((item) => <a href={`/directions/${item.id}/`} aria-label={`${item.letter} · ${item.name}`} aria-current={item.id === direction ? 'page' : undefined}><span>{item.letter}</span><span class="switch-name">{item.name}</span></a>)}</div>
      <a class="switch-baseline" href="/">当前首页</a>
    </nav>}
    <script src="../scripts/directions.ts"></script>
  </body>
</html>
