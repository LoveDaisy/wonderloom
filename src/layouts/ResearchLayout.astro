---
import { editions, editionPages, editionUrl, type EditionId, type EditionPage } from '../data/research-editions';
import '../styles/tokens.css';
import '../styles/research-editions.css';
interface Props { edition?: EditionId; page?: EditionPage; title: string; }
const { edition, page = 'home', title } = Astro.props;
const current = editions.find(item => item.id === edition);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Wonderloom · 个人研究手记与科学图谱。视觉与交互试样。" />
    <meta name="theme-color" content="#f6f2e4" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Wonderloom 试样</title>
  </head>
  <body class:list={['research-edition', edition ?? 'comparison', `view-${page}`]}>
    <a class="research-skip" href="#main">跳到主要内容</a>
    <nav class="edition-bar" aria-label="视觉试样比较">
      <a class="edition-overview" href="/directions/research/">设计试样 · 第一轮</a>
      <div>{editions.map(item => <a href={editionUrl(item.id, page)} aria-current={item.id === edition ? 'true' : undefined}>{item.letter}<span> · {item.name}</span></a>)}</div>
      <a href={page === 'home' ? '/' : `/${page}/`}>现有页面 ↗</a>
    </nav>
    <header class="research-header">
      <a class="research-wordmark" href={edition ? editionUrl(edition) : '/directions/research/'}>Wonderloom<span class="wordmark-dot" aria-hidden="true">.</span></a>
      <span class="research-byline">佳杰的{current?.name ?? '个人研究手记'}</span>
      {edition && <nav aria-label="主要导航">{editionPages.map(item => <a href={editionUrl(edition, item.id)} aria-current={item.id === page ? 'page' : undefined}>{item.title}</a>)}<a href="/projects/">项目</a><a href="/about/">关于</a></nav>}
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="research-footer">
      <p class="footer-note">好奇心，还在继续。</p>
      <div><a class="research-wordmark" href={edition ? editionUrl(edition) : '/directions/research/'}>Wonderloom.</a><span>光怪陆离的小屋 · 章佳杰</span><a href="/about/">关于这间小屋 ↗</a></div>
    </footer>
    <script src="../scripts/research-editions.ts"></script>
  </body>
</html>
