---
import { type Relation, type WorkId } from '../data/content-network';
import { getCatalogue, requireEntry } from '../lib/content';
interface Props { relations: Relation[]; currentId: WorkId; title: string; }
const { relations, currentId, title } = Astro.props;
const { worksById } = await getCatalogue();
---
{relations.length > 0 && <section class="loom-split loom-related" id="related-works" aria-labelledby="related-works-title">
  <div class="loom-section-heading"><h2 id="related-works-title">{title}</h2></div>
  <div data-work-id={currentId}><ul class="loom-topic-relations">{relations.map((relation) => {
    const other = requireEntry(worksById, relation.from === currentId ? relation.to : relation.from, 'Related work');
    return <li><p><a href={other.href} data-work-id={other.id}>{other.title}</a></p><p>{relation.explanation}</p></li>;
  })}</ul></div>
</section>}
