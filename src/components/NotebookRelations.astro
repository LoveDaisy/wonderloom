---
import NotebookSection from './NotebookSection.astro';
import { type Relation, type WorkId } from '../data/content-network';
import { getCatalogue, requireEntry } from '../lib/content';
interface Props { relations: Relation[]; currentId?: WorkId; title?: string; }
const { relations, currentId, title = '这些作品怎样相连' } = Astro.props;
const { worksById } = await getCatalogue();
---
{relations.length > 0 && <NotebookSection label="继续探索" id="related-works">
  <p slot="note">每一条联系，<br />都有具体的来由。</p>
  <div data-work-id={currentId}>
    <h2>{title}</h2>
    <ul class="nb-relation-list">{relations.map(relation => {
      const from = requireEntry(worksById, relation.from, 'Related work');
      const to = requireEntry(worksById, relation.to, 'Related work');
      const other = from.id === currentId ? to : from;
      return <li>
        {currentId ? <h3><a href={other.href} data-work-id={other.id}>{other.title} ↗</a></h3> : <h3><a href={from.href}>{from.title}</a><span class="nb-relation-join" aria-label="关联"> ↔ </span><a href={to.href}>{to.title}</a></h3>}
        <p>{relation.explanation}</p>
      </li>;
    })}</ul>
  </div>
</NotebookSection>}
