---
import { Image } from 'astro:assets';
import { media, type MediaId } from '../data/media';
interface Props { id: MediaId; compact?: boolean; eager?: boolean; }
const { id, compact = false, eager = false } = Astro.props;
const item = media[id];
---
<figure class:list={['media-figure', `media-${id}`, { 'media-compact': compact }]}>
  <a class="image-link" href={item.image.src} aria-label={`查看完整图片：${item.alt}`}>
    <Image src={item.image} alt={item.alt} format={id === 'halo' ? 'webp' : 'png'}
      width={Math.min(item.image.width, 1200)} quality={90}
      loading={eager ? 'eager' : 'lazy'} decoding="async" />
  </a>
  <figcaption>
    <span>{item.caption}</span>
    {!compact && <span class="credit">{item.credit} · 点击图片查看完整图</span>}
  </figcaption>
</figure>
