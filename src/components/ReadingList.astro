---
import type { CollectionEntry } from 'astro:content';
import { seriesUrl } from '../lib/content';
interface Props { entries: CollectionEntry<'series'>[]; }
const { entries } = Astro.props;
---
<ul class="reading-list">
  {entries.map((entry) => (
    <li>
      <a href={seriesUrl(entry)}>
        <span class="reading-title">{entry.data.title}</span>
        <span class="reading-summary">{entry.data.summary}</span>
        <span class="reading-count">{entry.data.chapters.length} 篇已发表</span>
      </a>
    </li>
  ))}
</ul>
