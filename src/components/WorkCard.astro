---
import type { CatalogueWork } from '../lib/content';
interface Props { work: CatalogueWork; index?: number; }
const { work, index } = Astro.props;
---
<article class="work-card">
  <p class="work-kind">{index !== undefined && <span>{String(index + 1).padStart(2, '0')} · </span>}{work.kind}</p>
  <h2><a href={work.href}>{work.title}</a></h2>
  <p>{work.summary}</p>
  <a class="text-link" href={work.href}>进入{work.kind}<span aria-hidden="true"> →</span></a>
</article>
