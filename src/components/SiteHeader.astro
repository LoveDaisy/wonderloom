---
import { site } from '../data/site';
const pathname = Astro.url.pathname;
---
<header class="site-header">
  <a class="site-brand" href="/" aria-label="Wonderloom 首页">
    <span>{site.name}</span><span class="brand-subtitle">{site.chineseName}</span>
  </a>
  <nav class="site-nav" aria-label="主导航">
    {site.navigation.map((item) => (
      <a href={item.href} aria-current={(item.href === '/' ? pathname === '/' : pathname.startsWith(item.href)) ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
  </nav>
</header>
