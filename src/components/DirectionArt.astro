---
interface Props { kind: 'orbit' | 'weave' | 'seal'; }
const { kind } = Astro.props;
---
{kind === 'orbit' && <svg class="orbit-art" viewBox="0 0 600 600" fill="none" aria-hidden="true">
  <circle cx="300" cy="300" r="246" />
  <circle cx="300" cy="300" r="284" stroke-dasharray="1 14" />
  <g class="orbit-turn"><ellipse cx="300" cy="300" rx="277" ry="120" transform="rotate(-35 300 300)" /><circle cx="527" cy="143" r="5" class="orbit-dot" /></g>
  <g class="orbit-turn reverse"><ellipse cx="300" cy="300" rx="260" ry="92" transform="rotate(50 300 300)" /><circle cx="147" cy="94" r="3" class="orbit-dot" /></g>
  <path d="M300 0v36m0 528v36M0 300h36m528 0h36" />
</svg>}
{kind === 'weave' && <svg class="weave-art" viewBox="0 0 600 600" fill="none" aria-hidden="true">
  <g class="weave-blue">
    {Array.from({length: 11}, (_, i) => <path d={`M${45 + i * 19} -20 C ${25 + i * 19} 175, ${520 - i * 12} 100, ${530 - i * 17} 300 S ${175 + i * 17} 420, ${190 + i * 18} 640`} />)}
  </g>
  <g class="weave-orange">
    {Array.from({length: 11}, (_, i) => <path d={`M-30 ${370 + i * 15} C 150 ${390 + i * 14}, 130 ${85 + i * 17}, 310 ${105 + i * 16} S 460 ${355 + i * 14}, 650 ${260 + i * 15}`} />)}
  </g>
</svg>}
{kind === 'seal' && <svg class="seal-art" viewBox="0 0 140 140" fill="none" aria-hidden="true">
  <circle cx="70" cy="70" r="63" /><circle cx="70" cy="70" r="56" stroke-dasharray="1 5" />
  <path d="m36 45 16 47 18-47 18 47 16-47M29 70l82-13M35 82l68-11" />
  <path d="M67 12h6m-6 116h6M12 67v6m116-6v6" />
</svg>}
