---
import { threadPath } from '../../lib/loom-threads';
---
<div class="nb-weave" data-notebook-weave>
  <svg class="nb-weave-art" viewBox="0 0 600 600" fill="none" aria-hidden="true" focusable="false">
    {(['warp', 'weft'] as const).map(axis => <g class={`nb-weave-${axis}`} data-weave-group={axis}>
      {Array.from({ length: 12 }, (_, index) => <path d={threadPath(index, axis, 0)} data-weave-axis={axis} data-weave-index={index} />)}
    </g>)}
  </svg>
  <button class="nb-weave-toggle" type="button" data-weave-toggle aria-label="暂停头图动画" aria-pressed="false" title="暂停头图动画" hidden>
    <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
      <path data-weave-pause d="M7 5v10M13 5v10" fill="none" stroke="currentColor" stroke-width="2" />
      <path data-weave-play d="m7 4 9 6-9 6Z" fill="currentColor" />
    </svg>
  </button>
</div>
<script src="../../scripts/notebook-weave.ts"></script>
