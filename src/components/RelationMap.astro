---
import { relations as allRelations, topics, type Relation, type WorkId } from '../data/content-network';
import type { CatalogueWork } from '../lib/content';
interface Props { works: CatalogueWork[]; relations?: Relation[]; currentId?: WorkId; title?: string; }
const { works, relations = allRelations, currentId, title = '作品关系图' } = Astro.props;
const columns = Math.max(1, Math.ceil(Math.sqrt(works.length)));
const rows = Math.max(1, Math.ceil(works.length / columns));
const positions = new Map(works.map((work, index) => [work.id, {
  x: 12 + (index % columns) * (76 / Math.max(1, columns - 1)),
  y: 17 + Math.floor(index / columns) * (66 / Math.max(1, rows - 1)),
}]));
const visibleRelations = relations.filter((relation) => positions.has(relation.from) && positions.has(relation.to));
const topicsFor = (work: CatalogueWork) => topics.filter((topic) => topic.workIds.includes(work.id)).map((topic) => topic.id).join(' ');
---
<section class="relation-map" data-relation-map aria-labelledby="relation-map-title">
  <div class="relation-map-heading">
    <div><p class="topic">人工关系 · 本轮收录范围</p><h2 id="relation-map-title">{title}</h2></div>
    <p>线条只表示下方列出的具体关联，不把共享标签当作自动推导的关系。</p>
  </div>
  <div class="relation-controls" data-relation-controls hidden aria-label="按主题高亮">
    <span>高亮主题：</span>
    {topics.map((topic) => <button type="button" data-topic={topic.id} aria-pressed="false">{topic.title}</button>)}
  </div>
  <p class="relation-status" data-relation-status aria-live="polite">所有节点均可直接打开；启用脚本后可按主题高亮。</p>
  <div class="relation-map-canvas" data-relation-canvas>
    <svg viewBox="0 0 100 100" role="img" aria-label={`${title}，${works.length} 个可点击节点和 ${visibleRelations.length} 条明确关系`}>
      {visibleRelations.map((relation) => {
        const from = positions.get(relation.from)!;
        const to = positions.get(relation.to)!;
        return <line class="relation-line" data-relation={`${relation.from} ${relation.to}`} x1={from.x} y1={from.y} x2={to.x} y2={to.y} />;
      })}
      {works.map((work) => {
        const position = positions.get(work.id)!;
        return <a class:list={['relation-node', currentId === work.id && 'is-current']} data-work-id={work.id} data-topics={topicsFor(work)} href={work.href} aria-label={`${work.kind}：${work.title}`}>
          <circle cx={position.x} cy={position.y} r="5.7" />
          <text x={position.x} y={position.y + 1.1}>{work.kind}</text>
          <text class="relation-node-label" x={position.x} y={position.y + 9}>{work.title}</text>
        </a>;
      })}
    </svg>
  </div>
  <ol class="relation-list">
    {visibleRelations.map((relation) => {
      const from = works.find((work) => work.id === relation.from)!;
      const to = works.find((work) => work.id === relation.to)!;
      return <li><a href={from.href}>{from.title}</a><span aria-hidden="true"> ↔ </span><a href={to.href}>{to.title}</a><p>{relation.explanation}</p></li>;
    })}
  </ol>
</section>
<script>
  document.querySelectorAll('[data-relation-map]').forEach((map) => {
    const controls = map.querySelector('[data-relation-controls]');
    const status = map.querySelector('[data-relation-status]');
    if (!(controls instanceof HTMLElement) || !(status instanceof HTMLElement)) return;
    controls.hidden = false;
    const buttons = [...controls.querySelectorAll<HTMLButtonElement>('button[data-topic]')];
    const nodes = [...map.querySelectorAll<SVGAElement>('[data-work-id]')];
    buttons.forEach((button) => button.addEventListener('click', () => {
      const active = button.dataset.topic;
      const alreadyActive = button.getAttribute('aria-pressed') === 'true';
      buttons.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button && !alreadyActive)));
      nodes.forEach((node) => node.classList.toggle('is-dimmed', !alreadyActive && !node.dataset.topics?.split(' ').includes(active ?? '')));
      status.textContent = alreadyActive ? '已显示全部节点。' : `已高亮${button.textContent}主题中的节点；所有节点仍可直接打开。`;
    }));
  });
</script>
