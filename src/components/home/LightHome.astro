---
import { Image } from 'astro:assets';
import { home } from '../../data/home';
import { media } from '../../data/media';
import { getCatalogue, requireEntry, sourceTitle, sourceUrl } from '../../lib/content';

const catalogue = await getCatalogue();
const series = home.featured.map((id) => requireEntry(catalogue.seriesById, id, 'Light home series'));
const lightPath = home.lightPath.map((step) => ({
  ...step,
  work: requireEntry(catalogue.worksById, step.workId, `Light path ${step.id}`),
  companion: step.companionWorkId ? requireEntry(catalogue.worksById, step.companionWorkId, `Light path ${step.id}`) : undefined,
  sources: step.sourceIds.map((id) => ({ title: sourceTitle(id, `Light path ${step.id}`), href: sourceUrl(id, `Light path ${step.id}`) })),
  medium: media[step.mediaId],
}));
---
<section class="light-opening site-shell" aria-labelledby="home-title">
  <div class="light-opening-copy">
    <p class="opening-eyebrow">你好，我是佳杰。欢迎来到光怪陆离的小屋</p>
    <h1 id="home-title">{home.headline.map((line) => <span>{line}</span>)}</h1>
    <p class="light-opening-intro">{home.description}</p>
    <a class="text-link opening-link" href="#light-path">从一束光开始 <span aria-hidden="true">↘</span></a>
  </div>
  <div class="light-opening-figure" aria-label="光、时间与山川的四张作品图">
    <svg class="opening-threads" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      <path class="thread-warp" d="M22 -5 C38 22 12 53 32 105 M58 -5 C44 22 75 56 58 105 M86 -5 C66 30 91 65 80 105" />
      <path class="thread-weft" d="M-5 15 C23 36 32 -1 58 20 S86 24 105 14 M-5 48 C20 69 36 26 63 48 S86 60 105 42 M-5 77 C26 92 35 56 66 75 S87 83 105 72" />
    </svg>
    <a class="opening-card opening-card-halo" href={media.halo.image.src} aria-label={`查看完整图片：${media.halo.alt}`}><Image src={media.halo.image} alt={media.halo.alt} width={360} loading="eager" fetchpriority="high" /></a>
    <a class="opening-card opening-card-celestial" href={media.celestial.image.src} aria-label={`查看完整图片：${media.celestial.alt}`}><Image src={media.celestial.image} alt={media.celestial.alt} width={340} loading="eager" /></a>
    <a class="opening-card opening-card-pyramids" href={media.pyramids.image.src} aria-label={`查看完整图片：${media.pyramids.alt}`}><Image src={media.pyramids.image} alt={media.pyramids.alt} width={330} loading="eager" /></a>
    <a class="opening-card opening-card-mountains" href={media.mountains.image.src} aria-label={`查看完整图片：${media.mountains.alt}`}><Image src={media.mountains.image} alt={media.mountains.alt} width={560} loading="eager" /></a>
    <p class="opening-figure-caption">FIG. 00 <span>光 / 时间 / 山川</span><span>几件正在看的东西</span></p>
  </div>
</section>

<section class="light-path site-shell" id="light-path" aria-labelledby="light-path-title">
  <header class="section-heading">
    <h2 id="light-path-title">一条光的线索</h2>
    <p class="section-summary">从冰晶中的折射，到计算、光谱与颜色。每一站都能回到真实的文章或项目。</p>
  </header>
  <ol class="light-path-list">
    {lightPath.map((step, index) => <li class="light-path-stop">
      <div class="light-path-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
      <div class="light-path-copy">
        <h3><a href={step.work.href}>{step.title}</a></h3>
        <p>{step.description}</p>
        <div class="light-path-actions">
          <a class="text-link" href={step.work.href}>读本站导读 <span aria-hidden="true">→</span></a>
          {step.companion && <a class="text-link" href={step.companion.href}>也读{step.companion.title} <span aria-hidden="true">→</span></a>}
        </div>
        <p class="source-note">出处：{step.sources.map((source, index) => <><a href={source.href}>{source.title}</a>{index < step.sources.length - 1 && '；'}</>)}</p>
      </div>
      <figure class="light-path-figure">
        <a href={step.medium.image.src} aria-label={`查看完整图片：${step.medium.alt}`}><Image src={step.medium.image} alt={step.medium.alt} width={900} loading={index === 0 ? 'eager' : 'lazy'} /></a>
        <figcaption>{step.medium.credit}</figcaption>
      </figure>
    </li>)}
  </ol>
</section>

<section class="home-other-questions site-shell" aria-labelledby="other-questions-title">
  <header class="section-heading"><h2 id="other-questions-title">更多正在追问的事</h2><p class="section-summary">光是其中的一条路。历法与山川，也各有自己的入口。</p></header>
  <div class="home-series-list">{series.map((entry, index) => <article><span class="home-series-number">{String(index + 1).padStart(2, '0')} / {entry.data.title}</span><h3><a href={`/writing/${entry.id}/`}>{entry.data.question}</a></h3><p>{entry.data.summary}</p><a class="text-link" href={`/writing/${entry.id}/`}>进入系列 <span aria-hidden="true">→</span></a></article>)}</div>
</section>

<section class="home-routes site-shell" aria-labelledby="routes-title">
  <div><h2 id="routes-title">把一个问题，读得更远一点。</h2></div>
  <div>{catalogue.homePaths.map((path) => <a href={`/explore/paths/${path.id}/`}><h3>{path.title} <span aria-hidden="true">→</span></h3><p>{path.description}</p></a>)}</div>
</section>

<section class="home-closing site-shell" aria-labelledby="closing-title"><h2 id="closing-title">关于这间小屋</h2><p class="home-closing-lead">{home.about}</p><a class="text-link" href="/about/">关于我与这间小屋 <span aria-hidden="true">→</span></a></section>
